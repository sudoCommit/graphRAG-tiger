CREATE GRAPH HetionetGraph()

USE GRAPH HetionetGraph
CREATE SCHEMA_CHANGE JOB add_hetionet_schema FOR GRAPH HetionetGraph {
ADD VERTEX Anatomy (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX BiologicalProcess (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX CellularComponent (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX Compound (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX Disease (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX Gene (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX MolecularFunction (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX Pathway (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX PharmacologicClass (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX SideEffect (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD VERTEX Symptom (
    PRIMARY_ID id STRING,
    name STRING,
    text_blob STRING
) WITH primary_id_as_attribute="true";

ADD DIRECTED EDGE Anatomy_localizes_Disease (FROM Anatomy, TO Disease);
ADD DIRECTED EDGE Anatomy_upregulates_Gene (FROM Anatomy, TO Gene);
ADD UNDIRECTED EDGE Anatomy_expresses_Gene (FROM Anatomy, TO Gene);
ADD DIRECTED EDGE Anatomy_downregulates_Gene (FROM Anatomy, TO Gene);

ADD DIRECTED EDGE SideEffect_causes_Compound (FROM SideEffect, TO Compound);

ADD DIRECTED EDGE Gene_downregulates_Disease (FROM Gene, TO Disease);
ADD DIRECTED EDGE Gene_upregulates_Disease (FROM Gene, TO Disease);
ADD DIRECTED EDGE Gene_associates_Disease (FROM Gene, TO Disease);
ADD DIRECTED EDGE Gene_downregulates_Compound (FROM Gene, TO Compound);
ADD DIRECTED EDGE Gene_upregulates_Compound (FROM Gene, TO Compound);
ADD DIRECTED EDGE Gene_binds_Compound (FROM Gene, TO Compound);
ADD DIRECTED EDGE Gene_regulates_Gene (FROM Gene, TO Gene);
ADD UNDIRECTED EDGE Gene_interacts_Gene (FROM Gene, TO Gene);
ADD UNDIRECTED EDGE Gene_covaries_Gene (FROM Gene, TO Gene);
ADD DIRECTED EDGE Gene_downregulates_Anatomy (FROM Gene, TO Anatomy);
ADD DIRECTED EDGE Gene_upregulates_Anatomy (FROM Gene, TO Anatomy);
ADD UNDIRECTED EDGE Gene_expresses_Anatomy (FROM Gene, TO Anatomy);
ADD UNDIRECTED EDGE Gene_participates_BiologicalProcess (FROM Gene, TO BiologicalProcess);
ADD UNDIRECTED EDGE Gene_participates_MolecularFunction (FROM Gene, TO MolecularFunction);
ADD UNDIRECTED EDGE Gene_participates_CellularComponent (FROM Gene, TO CellularComponent);
ADD UNDIRECTED EDGE Gene_participates_Pathway (FROM Gene, TO Pathway);

ADD UNDIRECTED EDGE PharmacologicClass_includes_Compound (FROM PharmacologicClass, TO Compound);

ADD UNDIRECTED EDGE Compound_includes_PharmacologicClass (FROM Compound, TO PharmacologicClass);
ADD DIRECTED EDGE Compound_treats_Disease (FROM Compound, TO Disease);
ADD DIRECTED EDGE Compound_palliates_Disease (FROM Compound, TO Disease);
ADD DIRECTED EDGE Compound_causes_SideEffect (FROM Compound, TO SideEffect);
ADD DIRECTED EDGE Compound_binds_Gene (FROM Compound, TO Gene);
ADD UNDIRECTED EDGE Compound_resembles_Compound (FROM Compound, TO Compound);
ADD DIRECTED EDGE Compound_upregulates_Gene (FROM Compound, TO Gene);
ADD DIRECTED EDGE Compound_downregulates_Gene (FROM Compound, TO Gene);

ADD DIRECTED EDGE Disease_downregulates_Gene (FROM Disease, TO Gene);
ADD DIRECTED EDGE Disease_upregulates_Gene (FROM Disease, TO Gene);
ADD DIRECTED EDGE Disease_associates_Gene (FROM Disease, TO Gene);
ADD DIRECTED EDGE Disease_presents_Symptom (FROM Disease, TO Symptom);
ADD UNDIRECTED EDGE Disease_resembles_Disease (FROM Disease, TO Disease);
ADD DIRECTED EDGE Disease_localizes_Anatomy (FROM Disease, TO Anatomy);
ADD DIRECTED EDGE Disease_treats_Compound (FROM Disease, TO Compound);
ADD DIRECTED EDGE Disease_palliates_Compound (FROM Disease, TO Compound);

ADD DIRECTED EDGE Symptom_presents_Disease (FROM Symptom, TO Disease);

ADD UNDIRECTED EDGE CellularComponent_participates_Gene (FROM CellularComponent, TO Gene);

ADD UNDIRECTED EDGE MolecularFunction_participates_Gene (FROM MolecularFunction, TO Gene);

ADD UNDIRECTED EDGE BiologicalProcess_participates_Gene (FROM BiologicalProcess, TO Gene);

ADD UNDIRECTED EDGE Pathway_participates_Gene (FROM Pathway, TO Gene);
}
RUN SCHEMA_CHANGE JOB add_hetionet_schema
