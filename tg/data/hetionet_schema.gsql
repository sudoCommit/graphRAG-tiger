CREATE VERTEX Anatomy (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX BiologicalProcess (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX CellularComponent (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX Compound (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX Disease (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX Gene (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX MolecularFunction (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX Pathway (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX PharmacologicClass (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX SideEffect (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE VERTEX Symptom (
    PRIMARY_ID id STRING,
    name STRING
) WITH primary_id_as_attribute="true";

CREATE UNDIRECTED EDGE Anatomy_downregulates_Gene (
    FROM Anatomy,
    TO Gene
);

CREATE UNDIRECTED EDGE Anatomy_expresses_Gene (
    FROM Anatomy,
    TO Gene
);

CREATE UNDIRECTED EDGE Anatomy_upregulates_Gene (
    FROM Anatomy,
    TO Gene
);

CREATE UNDIRECTED EDGE Compound_resembles_Compound (
    FROM Compound,
    TO Compound
);

CREATE UNDIRECTED EDGE Compound_palliates_Disease (
    FROM Compound,
    TO Disease
);

CREATE UNDIRECTED EDGE Compound_treats_Disease (
    FROM Compound,
    TO Disease
);

CREATE UNDIRECTED EDGE Compound_binds_Gene (
    FROM Compound,
    TO Gene
);

CREATE UNDIRECTED EDGE Compound_downregulates_Gene (
    FROM Compound,
    TO Gene
);

CREATE UNDIRECTED EDGE Compound_upregulates_Gene (
    FROM Compound,
    TO Gene
);

CREATE UNDIRECTED EDGE Compound_causes_SideEffect (
    FROM Compound,
    TO SideEffect
);

CREATE UNDIRECTED EDGE Disease_localizes_Anatomy (
    FROM Disease,
    TO Anatomy
);

CREATE UNDIRECTED EDGE Disease_resembles_Disease (
    FROM Disease,
    TO Disease
);

CREATE UNDIRECTED EDGE Disease_associates_Gene (
    FROM Disease,
    TO Gene
);

CREATE UNDIRECTED EDGE Disease_downregulates_Gene (
    FROM Disease,
    TO Gene
);

CREATE UNDIRECTED EDGE Disease_upregulates_Gene (
    FROM Disease,
    TO Gene
);

CREATE UNDIRECTED EDGE Disease_presents_Symptom (
    FROM Disease,
    TO Symptom
);

CREATE UNDIRECTED EDGE Gene_participates_BiologicalProcess (
    FROM Gene,
    TO BiologicalProcess
);

CREATE UNDIRECTED EDGE Gene_participates_CellularComponent (
    FROM Gene,
    TO CellularComponent
);

CREATE UNDIRECTED EDGE Gene_covaries_Gene (
    FROM Gene,
    TO Gene
);

CREATE UNDIRECTED EDGE Gene_interacts_Gene (
    FROM Gene,
    TO Gene
);

CREATE DIRECTED EDGE Gene_regulates_Gene (
    FROM Gene,
    TO Gene
);

CREATE UNDIRECTED EDGE Gene_participates_MolecularFunction (
    FROM Gene,
    TO MolecularFunction
);

CREATE UNDIRECTED EDGE Gene_participates_Pathway (
    FROM Gene,
    TO Pathway
);

CREATE UNDIRECTED EDGE PharmacologicClass_includes_Compound (
    FROM PharmacologicClass,
    TO Compound
);

CREATE GRAPH HetionetGraph (
    Anatomy, BiologicalProcess, CellularComponent, Compound, Disease, Gene, MolecularFunction, Pathway, PharmacologicClass, SideEffect, Symptom, Anatomy_downregulates_Gene, Anatomy_expresses_Gene, Anatomy_upregulates_Gene, Compound_resembles_Compound, Compound_palliates_Disease, Compound_treats_Disease, Compound_binds_Gene, Compound_downregulates_Gene, Compound_upregulates_Gene, Compound_causes_SideEffect, Disease_localizes_Anatomy, Disease_resembles_Disease, Disease_associates_Gene, Disease_downregulates_Gene, Disease_upregulates_Gene, Disease_presents_Symptom, Gene_participates_BiologicalProcess, Gene_participates_CellularComponent, Gene_covaries_Gene, Gene_interacts_Gene, Gene_regulates_Gene, Gene_participates_MolecularFunction, Gene_participates_Pathway, PharmacologicClass_includes_Compound
);